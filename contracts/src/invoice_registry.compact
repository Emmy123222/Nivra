//
// InvoiceRegistry: private invoice commitments, merchant authorization,
// lifecycle state, and (incrementally) payment settlement.
//
// See docs/PROTOCOL_ARCHITECTURE.md, docs/STATE_MACHINE.md and
// docs/INVARIANTS.md for the design this implements.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum InvoiceState {
  ACTIVE,
  PAID,
  CANCELLED,
  EXPIRED
}

export struct InvoiceRecord {
  state: InvoiceState;
  merchantCommitment: Bytes<32>;
  expiry: Uint<64>;
  // Binds settlement to a specific coin so claimSettlement cannot be pointed at an
  // unrelated coin the contract happens to hold, or at the same coin twice across
  // different invoices. See docs/INVARIANTS.md, INVARIANT 8.
  paidCoinCommitment: Bytes<32>;
  claimed: Boolean;
}

export ledger invoices: Map<Bytes<32>, InvoiceRecord>;

constructor() {}

circuit merchantCommitmentOf(merchantSecret: Bytes<32>, merchantNonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "nivra:merchant:v1"), merchantSecret, merchantNonce]);
}

circuit invoiceCommitmentOf(
  merchantCommitment: Bytes<32>,
  amount: Uint<64>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "nivra:invoice:v1"),
    merchantCommitment,
    amount as Field as Bytes<32>,
    tokenColor,
    expiry as Field as Bytes<32>,
    metadataHash,
    invoiceSecret,
    nonce
  ]);
}

witness localMerchantSecret(): Bytes<32>;
witness localMerchantNonce(): Bytes<32>;

export circuit createInvoice(
  amount: Uint<64>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): Bytes<32> {
  assert(amount > 0, "Amount must be positive");
  const merchantCommitment = disclose(merchantCommitmentOf(localMerchantSecret(), localMerchantNonce()));
  const commitment = disclose(invoiceCommitmentOf(
    merchantCommitment, amount, tokenColor, expiry, metadataHash, invoiceSecret, nonce
  ));
  assert(!invoices.member(commitment), "Invoice with this commitment already exists");
  invoices.insert(commitment, InvoiceRecord {
    state: InvoiceState.ACTIVE,
    merchantCommitment: merchantCommitment,
    expiry: disclose(expiry),
    paidCoinCommitment: default<Bytes<32>>,
    claimed: false
  });
  return commitment;
}

export circuit cancelInvoice(
  amount: Uint<64>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): [] {
  const merchantCommitment = disclose(merchantCommitmentOf(localMerchantSecret(), localMerchantNonce()));
  const commitment = disclose(invoiceCommitmentOf(
    merchantCommitment, amount, tokenColor, expiry, metadataHash, invoiceSecret, nonce
  ));
  assert(invoices.member(commitment), "No such invoice");
  const record = invoices.lookup(commitment);
  assert(record.state == InvoiceState.ACTIVE, "Invoice is not active");
  assert(record.merchantCommitment == merchantCommitment, "Not the authorized merchant");
  invoices.insert(commitment, InvoiceRecord {
    state: InvoiceState.CANCELLED,
    merchantCommitment: record.merchantCommitment,
    expiry: record.expiry,
    paidCoinCommitment: record.paidCoinCommitment,
    claimed: record.claimed
  });
}

witness incomingPaymentCoin(): ShieldedCoinInfo;
witness localPayerReceiptSecret(): Bytes<32>;

export ledger receipts: Map<Bytes<32>, Bytes<32>>;

export circuit settleInvoice(
  merchantCommitment: Bytes<32>,
  amount: Uint<64>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): [] {
  const commitment = disclose(invoiceCommitmentOf(
    merchantCommitment, amount, tokenColor, expiry, metadataHash, invoiceSecret, nonce
  ));
  assert(invoices.member(commitment), "No such invoice");
  const record = invoices.lookup(commitment);
  assert(record.state == InvoiceState.ACTIVE, "Invoice is not active");
  assert(blockTimeLt(disclose(expiry)), "Invoice has expired");

  const coin = incomingPaymentCoin();
  assert(coin.color == tokenColor, "Wrong token for this invoice");
  assert(coin.value == amount as Uint<128>, "Coin value does not match invoice amount");
  receiveShielded(disclose(coin));

  const paidCoinCommitment = disclose(persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "nivra:coin:v1"),
    coin.nonce,
    coin.color,
    coin.value as Field as Bytes<32>
  ]));

  invoices.insert(commitment, InvoiceRecord {
    state: InvoiceState.PAID,
    merchantCommitment: record.merchantCommitment,
    expiry: record.expiry,
    paidCoinCommitment: paidCoinCommitment,
    claimed: false
  });
  receipts.insert(commitment, disclose(persistentHash<Vector<2, Bytes<32>>>([commitment, localPayerReceiptSecret()])));
}

witness heldCoin(): QualifiedShieldedCoinInfo;
witness merchantPayoutKey(): ZswapCoinPublicKey;

export circuit claimSettlement(
  amount: Uint<64>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): [] {
  const merchantCommitment = disclose(merchantCommitmentOf(localMerchantSecret(), localMerchantNonce()));
  const commitment = disclose(invoiceCommitmentOf(
    merchantCommitment, amount, tokenColor, expiry, metadataHash, invoiceSecret, nonce
  ));
  assert(invoices.member(commitment), "No such invoice");
  const record = invoices.lookup(commitment);
  assert(record.state == InvoiceState.PAID, "Invoice is not paid");
  assert(record.merchantCommitment == merchantCommitment, "Not the authorized merchant");
  assert(!record.claimed, "Settlement for this invoice has already been claimed");

  const coin = heldCoin();
  const offeredCoinCommitment = disclose(persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "nivra:coin:v1"),
    coin.nonce,
    coin.color,
    coin.value as Field as Bytes<32>
  ]));
  assert(offeredCoinCommitment == record.paidCoinCommitment, "Offered coin does not match this invoice's settlement");

  sendShielded(disclose(coin), left<ZswapCoinPublicKey, ContractAddress>(disclose(merchantPayoutKey())), disclose(amount as Uint<128>));

  invoices.insert(commitment, InvoiceRecord {
    state: record.state,
    merchantCommitment: record.merchantCommitment,
    expiry: record.expiry,
    paidCoinCommitment: record.paidCoinCommitment,
    claimed: true
  });
}

export circuit markExpired(
  amount: Uint<64>,
  merchantCommitment: Bytes<32>,
  tokenColor: Bytes<32>,
  expiry: Uint<64>,
  metadataHash: Bytes<32>,
  invoiceSecret: Bytes<32>,
  nonce: Bytes<32>
): [] {
  const commitment = disclose(invoiceCommitmentOf(
    merchantCommitment, amount, tokenColor, expiry, metadataHash, invoiceSecret, nonce
  ));
  assert(invoices.member(commitment), "No such invoice");
  const record = invoices.lookup(commitment);
  assert(record.state == InvoiceState.ACTIVE, "Invoice is not active");
  assert(blockTimeGte(disclose(expiry)), "Invoice has not expired yet");
  invoices.insert(commitment, InvoiceRecord {
    state: InvoiceState.EXPIRED,
    merchantCommitment: record.merchantCommitment,
    expiry: record.expiry,
    paidCoinCommitment: record.paidCoinCommitment,
    claimed: record.claimed
  });
}
