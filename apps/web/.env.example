# Midnight network requested from the wallet. Supported by this build: preprod, preview.
NEXT_PUBLIC_NETWORK_ID=preprod

# Fallback only. Nivra first requests delegated proving from the connected wallet,
# then uses the wallet's configured proverServerUri. This URL is used only when
# neither wallet option is available.
NEXT_PUBLIC_PROOF_SERVER_URL=http://127.0.0.1:6300
